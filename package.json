{
  "name": "study-connect",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit -p tsconfig.json",
    "lint:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:min-auth": "ts-node scripts/min-auth-check.ts",
    "test:min-auth-session-invalidation": "ts-node scripts/min-auth-session-invalidation-check.ts",
    "test:min-material-upload": "ts-node scripts/min-material-upload-check.ts",
    "test:min-admin-review": "ts-node scripts/min-admin-review-check.ts",
    "test:min-material-search": "ts-node scripts/min-material-search-check.ts",
    "test:min-material-download": "ts-node scripts/min-material-download-check.ts",
    "test:min-material-rating": "ts-node scripts/min-material-rating-check.ts",
    "test:min-csrf-regression": "ts-node scripts/min-csrf-regression-check.ts",
    "test:min-rate-limit": "TS_NODE_TRANSPILE_ONLY=1 ts-node scripts/min-rate-limit-check.ts",
    "test:min-rate-limit-identity": "ts-node scripts/min-rate-limit-identity-check.ts",
    "check:prisma": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/study_connect?schema=public\" prisma validate",
    "check:quality": "npm run lint && npm run build && npm run check:prisma",
    "test:min-all": "node scripts/min-all-runner.cjs",
    "test:min-admin-update-review-errors": "ts-node scripts/min-admin-update-material-review-error-check.ts",
    "test:min-material-upload-size-boundary": "ts-node scripts/min-material-upload-size-boundary-check.ts",
    "test:min-material-upload-security-regression": "ts-node scripts/min-material-upload-security-regression-check.ts",
    "test:min-cors-config": "ts-node scripts/min-cors-config-check.ts",
    "test:min-auth-token-hardening": "ts-node scripts/min-auth-token-hardening-check.ts",
    "test:min-recommendations": "ts-node scripts/min-recommendations-check.ts",
    "cleanup:otp": "ts-node scripts/cleanup-otp-attempts.ts",
    "backfill:material-counters": "ts-node scripts/backfill-material-counters.ts",
    "test:min-file-scan-async": "ts-node scripts/min-file-scan-async-check.ts",
    "test:min-recommend-tiering": "ts-node scripts/min-recommend-tiering-check.ts",
    "test:min-search-fts": "ts-node scripts/min-search-fts-check.ts",
    "cleanup:behavior-data": "ts-node scripts/cleanup-behavior-data.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/client": "^6.7.0",
    "@sentry/node": "^9.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "dotenv": "^16.4.7",
    "nestjs-pino": "^4.4.1",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.1.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "prettier": "^3.4.2",
    "prisma": "^6.7.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
