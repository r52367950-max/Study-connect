generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum MaterialVisibility {
  PUBLIC
  PRIVATE
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum MaterialStatus {
  PENDING
  APPROVED
  REJECTED
  OFFLINE
}

enum ProfileRole {
  TEACHER
  STUDENT
}

enum MaterialKind {
  EXERCISE
  HANDOUT
  EXAM
  MOCK
}

enum FileSafetyStatus {
  QUARANTINED
  SCANNING
  PASSED
  FAILED
  TIMEOUT
}

enum FileScanJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  username     String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  tokenVersion Int        @default(0) @map("token_version")
  avatarUrl    String?    @map("avatar_url")

  profileRole          ProfileRole? @map("profile_role")
  displayName          String?      @map("display_name")
  schoolId             String?      @map("school_id") @db.Uuid
  schoolNameFreeText   String?      @map("school_name_free_text")
  city                 String?
  stages               String[]     @default([])
  grades               String[]     @default([])
  subjects             String[]     @default([])
  viewedKinds          String[]     @default([]) @map("viewed_kinds")
  collaborativeOptIn   Boolean      @default(true) @map("collaborative_opt_in")
  onboardedAt          DateTime?    @map("onboarded_at")
  gradesUpdatedAt      DateTime?    @map("grades_updated_at")

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  school       School?    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  materials    Material[]
  ratings      Rating[]
  downloads    Download[]
  favorites    Favorite[]
  viewEvents   ViewEvent[]

  @@index([phone])
  @@index([email])
  @@index([schoolId])
  @@map("users")
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  city      String
  pinyin    String
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]

  @@unique([city, name])
  @@index([city, name])
  @@index([pinyin])
  @@map("schools")
}

model Material {
  id            String             @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  stage         String?
  grade         String?
  subject       String?
  kind          MaterialKind?
  year          Int?
  region        String?
  fileKey       String             @map("file_key")
  visibility    MaterialVisibility @default(PUBLIC)
  status        MaterialStatus     @default(PENDING)
  reviewComment String?            @map("review_comment")
  fileSafetyStatus FileSafetyStatus? @map("file_safety_status")
  // Denormalized read-path counters. downloadCount is incremented atomically with
  // each Download row; ratingSum/ratingCount are recomputed from ratings after each
  // upsert (convergent — a concurrent stale write self-heals on the next rating).
  // Rebuild after manual data surgery with scripts/backfill-material-counters.ts.
  downloadCount Int                @default(0) @map("download_count")
  ratingSum     Int                @default(0) @map("rating_sum")
  ratingCount   Int                @default(0) @map("rating_count")
  uploaderId    String             @map("uploader_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  uploader      User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  ratings       Rating[]
  downloads     Download[]
  favorites     Favorite[]
  viewEvents    ViewEvent[]
  fileScanJob   FileScanJob?

  @@index([uploaderId])
  @@index([status, createdAt])
  // Covers the public-list WHERE (status, visibility, safety) so the per-page
  // COUNT(*) runs as an index-only scan instead of a seq scan.
  @@index([status, visibility, fileSafetyStatus])
  @@index([status, subject])
  @@index([status, stage, grade])
  @@index([status, year])
  @@index([status, region])
  @@index([status, kind])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "materials_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "materials_description_trgm_idx")
  @@map("materials")
}

model Rating {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  materialId  String    @map("material_id") @db.Uuid
  score       Int
  comment     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
  @@index([materialId, createdAt])
  @@map("ratings")
}

model Download {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  materialId   String    @map("material_id") @db.Uuid
  downloadedAt DateTime  @default(now()) @map("downloaded_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  material     Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([materialId])
  @@map("downloads")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId, createdAt])
  @@index([materialId])
  @@map("favorites")
}

model ViewEvent {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  materialId String       @map("material_id") @db.Uuid
  kind       MaterialKind?
  dwellMs    Int          @default(0) @map("dwell_ms")
  createdAt  DateTime     @default(now()) @map("created_at")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([materialId])
  @@map("view_events")
}

model OtpAttempt {
  id         String     @id @default(uuid()) @db.Uuid
  identifier String
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  ip         String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([identifier, purpose, createdAt])
  @@index([identifier, channel, purpose, createdAt])
  @@index([ip, createdAt])
  @@index([identifier, createdAt])
  @@map("otp_attempts")
}


model FileScanJob {
  id          String            @id @default(uuid()) @db.Uuid
  materialId  String            @unique @map("material_id") @db.Uuid
  fileKey     String            @map("file_key")
  status      FileScanJobStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  scheduledAt DateTime          @default(now()) @map("scheduled_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  material    Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@map("file_scan_jobs")
}
