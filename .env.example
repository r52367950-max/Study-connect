DATABASE_URL="postgresql://postgres:postgres@localhost:5432/study_connect?schema=public"
JWT_SECRET="replace-with-strong-secret"
# OTP_SECRET is used to HMAC OTP codes at rest. Defaults to JWT_SECRET if unset.
OTP_SECRET=""
CORS_ORIGIN="http://localhost:3001"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"
TRUST_PROXY=""  # set to "1" or a hop count when behind a reverse proxy
RATE_LIMIT_GLOBAL_LIMIT="120"  # 全局限流次数/分钟 global limit per minute
RATE_LIMIT_GLOBAL_WINDOW_MS="60000"  # 全局限流窗口(ms) global rate window
RATE_LIMIT_LOGIN_LIMIT="20"  # 登录接口限流次数/分钟 login attempt limit
RATE_LIMIT_LOGIN_WINDOW_MS="60000"  # 登录接口限流窗口(ms) login rate window
RATE_LIMIT_LOGIN_MAX_FAILURES="5"  # 连续失败阈值 max failures before lock
RATE_LIMIT_LOGIN_FAILURE_WINDOW_MS="60000"  # 失败统计窗口(ms) failure counting window
RATE_LIMIT_LOGIN_LOCK_MS="300000"  # 锁定时长(ms) lock duration
JWT_ACCESS_TTL_SECONDS="900"  # Access Token 有效期(秒)
JWT_REFRESH_TTL_SECONDS="604800"  # Refresh Token 有效期(秒)
AUTH_OTP_TEST_BYPASS=""  # 仅开发使用 dev only, never set in prod
OTP_DAILY_CAP="10"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"  # 本地 MinIO 默认 HTTP use HTTPS only when enabled
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="study-connect"
MINIO_SIGNED_URL_TTL_SECONDS="300"
MINIO_REGION="us-east-1"  # MinIO/S3 区域 region for signature scope
MAX_UPLOAD_SIZE_MB="50"
FILE_SCAN_DELAY_MS=""  # 可选 optional; defaults inside file-scan.service.ts

# —— OTP providers (all optional; dev falls back to console logger) ——
# Aliyun SMS: requires `npm install @alicloud/dysmsapi20170525 @alicloud/openapi-client`
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""
ALIYUN_SMS_ENDPOINT="dysmsapi.aliyuncs.com"

# Email OTP via SMTP: requires `npm install nodemailer`
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
LOG_LEVEL=""
